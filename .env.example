
# ==============================================================================
# DIY TECH PROJECTS E-COMMERCE PLATFORM — ENVIRONMENT CONFIGURATION
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=True
SECRET_KEY=change-this-to-a-super-secret-random-32-char-key-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration
# Local SQLite (zero-setup development default):
DATABASE_URL=sqlite+aiosqlite:///./diy_store.db
# Production PostgreSQL:
# DATABASE_URL=postgresql+asyncpg://diy_user:diy_secret_password@localhost:5432/diy_store

# CORS Origins (Comma-separated URLs allowed to make API requests)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ==============================================================================
# PAYMENT GATEWAY (RAZORPAY INDIA)
# ==============================================================================
# Obtain from https://dashboard.razorpay.com/#/app/keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret_key
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ==============================================================================
# PRODUCT IMAGE & FILE STORAGE
# ==============================================================================
# Supported: local, cloudinary, s3
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads

# If STORAGE_BACKEND=cloudinary:
# CLOUDINARY_CLOUD_NAME=your_cloud_name
# CLOUDINARY_API_KEY=your_cloudinary_key
# CLOUDINARY_API_SECRET=your_cloudinary_secret

# If STORAGE_BACKEND=s3:
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_REGION=ap-south-1
# AWS_S3_BUCKET=diy-tech-products-bucket

# ==============================================================================
# NOTIFICATION INTEGRATIONS
# ==============================================================================
# Email Notification (Resend or AWS SES)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_your_resend_api_key
FROM_EMAIL=orders@vktechnology.in

# Designated Store Owner Notifications (Karthik)
OWNER_NOTIFICATION_EMAIL=karthik.suroju@gmail.com
OWNER_NOTIFICATION_PHONE=+918555997052

# WhatsApp Messaging (Meta Cloud API)
WHATSAPP_PHONE_NUMBER_ID=your_meta_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_meta_system_user_access_token

# SMS Gateway (Twilio, Msg91, or mock)
SMS_PROVIDER=mock
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_token
TWILIO_FROM_NUMBER=+1234567890

# ==============================================================================
# STORE BUSINESS DEFAULTS
# ==============================================================================
DEFAULT_CURRENCY=INR
DEFAULT_CURRENCY_SYMBOL=₹
DEFAULT_SHIPPING_PAISE=7000
FREE_SHIPPING_THRESHOLD_PAISE=99900
DEFAULT_TAX_RATE_PERCENT=18.0
COD_ENABLED=true
COD_MAX_LIMIT_PAISE=2500000
